# --- LLM PROVIDERS ---
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# --- DATABASE ---
# Local dev (SQLite — default, không cần sửa)
DATABASE_URL="sqlite+aiosqlite:///./conversations.db"
# Production (PostgreSQL — uncomment khi dùng Docker)
# DATABASE_URL="postgresql+asyncpg://user:password@db:5432/noc_agent"

# --- OBSERVABILITY (LANGFUSE) ---
LANGFUSE_PUBLIC_KEY="your-public-key"
LANGFUSE_SECRET_KEY="your-secret-key"
LANGFUSE_HOST="https://cloud.langfuse.com"

# --- SKILL: NODE HEALTH (SSH) ---
SSH_HOST="ip"
SSH_PORT=22
SSH_USER="username"
SSH_PASSWORD="password"
SSH_KEY_PATH=""              # Optional: path to SSH private key (ưu tiên hơn password)

# --- SKILL: ALARM ENRICHMENT (DATABASE) ---
CH_HOST=""
CH_PORT=8123
CH_USER=""
CH_PASSWORD=""
PG_DSN=""
