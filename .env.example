# --- LLM PROVIDERS ---
OPENAI_API_KEY="sk-proj-fake-openai-key-do-not-use"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY="sk-ant-fake-anthropic-key-do-not-use"
ANTHROPIC_MODEL="claude-3"
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_REASONING_MAX_TOKENS=1024

# --- SECURITY ---
CORS_ORIGINS="http://localhost:5173"
DEPLOYMENT_MODE=development
AUTH_MODE=local
# Production: bearer mode + SHA-256 token digests, roles and explicit scopes.
# Never put raw bearer tokens in this JSON. Generate them with create_principal.py.
AUTH_PRINCIPALS_JSON=[]
DATA_MODE=live
WORKER_MODE=embedded
MAX_ACTIVE_RUNS_PER_ACTOR=4
RUN_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=2
LLM_CONTEXT_TOKENS=32768
LLM_RESERVED_OUTPUT_TOKENS=4096
LLM_CONTEXT_MARGIN=1024
LLM_OUTPUT_MAX_BYTES=65536
LLM_FALLBACK_PROVIDERS=""
LLM_RUN_TOKEN_LIMIT=1000000
# Optional cost admission estimate; keep rates in one configured currency.
# Example shape: {"your-model":{"input_per_million":0.0,"output_per_million":0.0}}
LLM_MODEL_PRICES_JSON={}
LLM_PRICE_CONFIG_VERSION="unconfigured"
LLM_BUDGET_CURRENCY=USD
TOOL_OUTPUT_MAX_BYTES=16384
# Optional isolated sandbox daemon; image must be pre-pulled and pinned by digest.
SANDBOX_IMAGE=""
# DOCKER_HOST / DOCKER_TLS_VERIFY / DOCKER_CERT_PATH configure Docker CLI externally.

# --- DATABASE ---
DATABASE_URL="sqlite+aiosqlite:///./conversations.db"

# --- OBSERVABILITY (LANGFUSE) ---
LANGFUSE_PUBLIC_KEY="pk-lf-fake-public-key"
LANGFUSE_SECRET_KEY="sk-lf-fake-secret-key"
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGFUSE_TRACE_THINKING_CONTENT=false

# --- SKILL: NODE HEALTH (SSH) ---
SSH_HOST="192.168.1.100"
SSH_PORT=22
SSH_USER="admin"
SSH_PASSWORD="fake-password123"
SSH_KEY_PATH=""
# Trusted known_hosts file, including [host]:port entries for non-default ports.
# Verify fingerprints independently. In Docker, mount this file read-only and
# set SSH_KNOWN_HOSTS to its container path. Empty uses the user's known_hosts.
SSH_KNOWN_HOSTS=""
SSH_AUTO_ADD_HOST_KEYS=false  # Explicit development-only opt-in; never replaces changed keys.
SSH_ALLOWED_HOSTS=""        # Exact comma-separated names/IPs. Empty denies remediation.
SSH_ALLOWED_SERVICES=""     # Exact Docker container names; no wildcards.
ALLOW_DOCKER_RESTART=false
REMEDIATION_COOLDOWN_SECONDS=60
APPROVAL_ACTION_TIMEOUT_SECONDS=45
SSH_CONNECT_TIMEOUT_SECONDS=5
SSH_AUTH_TIMEOUT_SECONDS=5
SSH_TOTAL_TIMEOUT_SECONDS=20
SSH_OUTPUT_MAX_BYTES=65536   # Retained bytes per stream; extra output is drained and flagged.
# --- SKILL: ALARM ENRICHMENT (CLICKHOUSE) ---
CLICKHOUSE_HOST="10.0.0.5"
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="fake-clickhouse-pw"
CLICKHOUSE_DATABASE="alarm_data"

# --- SKILL: ALARM ENRICHMENT (POSTGRESQL) ---
POSTGRES_HOST="10.0.0.6"
POSTGRES_PORT=5432
POSTGRES_USER="postgres_name"
POSTGRES_PASSWORD="fake-postgres-pw"
POSTGRES_DB="fake_db"
