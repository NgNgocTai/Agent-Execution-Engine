{
  "scripts": [{
    "entrypoint": "scripts/triage_site_alarms.py",
    "purpose": "Rank active-alarm impact for one site from backend-supplied records",
    "timeout_seconds": 10,
    "output_contract": "json",
    "capability": "site_alarms",
    "capability_field": "alarms",
    "input_fields": [
      {"name": "site", "kind": "string"},
      {"name": "alarms", "kind": "array", "shape": {
        "type": "array", "maxItems": 100,
        "items": {"type": "object", "required": ["alarm_id", "error_code", "device_id", "severity", "time_created", "status"],
          "properties": {
            "alarm_id": {"type": "string", "maxLength": 64},
            "error_code": {"type": "string", "maxLength": 64},
            "device_id": {"type": "string", "maxLength": 100},
            "severity": {"type": "string", "maxLength": 32},
            "time_created": {"type": "string", "maxLength": 40},
            "status": {"type": "string", "maxLength": 32}}}}}
    ],
    "sample_input": {"site": "STN-A", "alarms": [
      {"alarm_id": "ALM-0000000001", "error_code": "LINK_DOWN", "device_id": "d1", "severity": "Critical", "time_created": "2026-11-17 10:00:00", "status": "active"},
      {"alarm_id": "ALM-0000000002", "error_code": "HIGH_TEMP", "device_id": "d2", "severity": "Warning", "time_created": "2026-11-17 10:05:00", "status": "active"}]},
    "output_schema": {
      "type": "object",
      "required": ["calibration", "site", "data_status", "alarm_count", "impact_level", "score", "drivers", "warnings"],
      "properties": {
        "calibration": {"type": "string", "maxLength": 40},
        "site": {"type": "string", "maxLength": 64},
        "data_status": {"type": "string", "enum": ["ok", "no_alarms"]},
        "alarm_count": {"type": "integer", "minimum": 0},
        "distinct_devices": {"type": "integer", "minimum": 0},
        "severity_counts": {"type": "object", "properties": {
          "critical": {"type": "integer"}, "major": {"type": "integer"}, "minor": {"type": "integer"},
          "warning": {"type": "integer"}, "unknown": {"type": "integer"}}},
        "top_error_codes": {"type": "array", "maxItems": 5, "items": {"type": "object",
          "required": ["error_code", "count"], "properties": {"error_code": {"type": "string"}, "count": {"type": "integer"}}}},
        "newest_alarm_at": {"type": "string", "maxLength": 40},
        "oldest_alarm_at": {"type": "string", "maxLength": 40},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "impact_level": {"type": "string", "enum": ["none_observed", "low", "medium", "high"]},
        "drivers": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 200}},
        "interpretation": {"type": "string", "maxLength": 300},
        "warnings": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 200}}}}
  }]
}
